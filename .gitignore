# Dependencias
node_modules/

# Build
dist/
build/

# Tests
coverage/

# Variables de entorno (nunca versionar secretos reales)
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example
!.env.lab.example

# Almacenamiento de archivos subidos (evidencias). Anclado a la raíz: sin
# la barra inicial también ignoraría api/src/storage/ (el módulo de código).
/storage/
# STORAGE_DIR de api/.env.test (../storage-test): mismas evidencias, pero
# generadas al correr `npm run test:e2e`, nunca se deben versionar.
/storage-test/

# Respaldos de npm run db:backup (api/scripts/db-backup.ts): son datos
# reales de desarrollo, nunca se versionan.
/backups/

# Certificados y llaves
*.pem
*.key
*.crt

# Logs
*.log
npm-debug.log*

# Editores / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
