{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:lab": "node --env-file=.env.lab dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "node scripts/assert-test-database.js",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
    "seed:admin:lab": "node --env-file=.env.lab dist/scripts/seed-admin.js",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seed-demo.ts",
    "seed:demo:lab": "node --env-file=.env.lab dist/scripts/seed-demo.js",
    "cleanup:zap": "ts-node -r tsconfig-paths/register scripts/cleanup-zap.ts",
    "db:backup": "ts-node -r tsconfig-paths/register scripts/db-backup.ts",
    "db:restore": "ts-node -r tsconfig-paths/register scripts/db-restore.ts",
    "openapi:export": "nest build && node dist/scripts/export-openapi.js",
    "captcha:solve": "ts-node -r tsconfig-paths/register scripts/captcha-solve.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.5",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "js-yaml": "^5.4.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
