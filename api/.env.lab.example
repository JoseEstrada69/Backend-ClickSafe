# Copia este archivo a api/.env (NO se versiona) para la demo del laboratorio.
# Topología: 3 PCs Windows sin internet, sin Nginx/TLS. API en 192.168.20.10,
# MySQL en 192.168.30.10, Mailpit en la misma PC que la API, panel de admin
# en una 3ra PC, app iOS por WiFi. Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# y pégalo en vez del marcador "GENERA-UN-SECRETO-..." -- NUNCA subas los
# valores reales a GitHub.

NODE_ENV=production
PORT=3000

# Sin Nginx delante en el laboratorio, la API debe exponerse directo a la
# red para que la app iOS y el panel de admin (otras PCs) lleguen a ella --
# por eso aquí SÍ se fija HOST, anulando el valor por defecto de producción
# (127.0.0.1, pensado para cuando hay Nginx en la misma máquina, ver
# .env.example). 0.0.0.0 = escuchar en todas las interfaces de esta PC.
HOST=0.0.0.0

# Vacío por ahora -- se confirma después con el equipo del panel de admin
# (qué origen exacto usará en el laboratorio). Mientras esté vacío, CORS
# sigue deshabilitado (la app iOS no lo necesita; solo lo necesitaría un
# panel de admin servido desde un origen distinto al de la API).
CORS_ORIGINS=

# false: no hay Nginx (ni ningún proxy) delante de la API en el laboratorio.
# Si se activara sin proxy real, un atacante podría falsificar su IP con
# X-Forwarded-For y evadir el rate limiting.
TRUST_PROXY=false

# false también en el laboratorio: no hace falta exponer /api/docs para la
# demo y así no se regala un mapa de la API a quien esté en la misma red.
SWAGGER_ENABLED=false

JWT_ACCESS_SECRET=GENERA-UN-SECRETO-DE-AL-MENOS-32-CARACTERES
JWT_ISSUER=clicksafe-api
JWT_AUDIENCE=clicksafe-app

JWT_MFA_SECRET=GENERA-UN-SECRETO-DISTINTO-DE-AL-MENOS-32-CARACTERES

# Debe decodificar a 32 bytes exactos en base64 -- usa el mismo comando de
# arriba (randomBytes(32).toString('base64')), no un string arbitrario.
TOTP_ENCRYPTION_KEY=GENERA-32-BYTES-EN-BASE64

CODE_HMAC_KEY=GENERA-UN-SECRETO-DISTINTO-DE-AL-MENOS-32-CARACTERES
CAPTCHA_HMAC_KEY=GENERA-UN-SECRETO-DISTINTO-DE-AL-MENOS-32-CARACTERES
EVIDENCE_URL_SECRET=GENERA-UN-SECRETO-DISTINTO-DE-AL-MENOS-32-CARACTERES

# Límites de 4.4 sin cambios para la demo.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_REPORTS_TTL_MS=3600000
THROTTLE_REPORTS_LIMIT=10
THROTTLE_COMMENTS_TTL_MS=3600000
THROTTLE_COMMENTS_LIMIT=30
THROTTLE_FLAGS_TTL_MS=3600000
THROTTLE_FLAGS_LIMIT=20

# MySQL en su propia PC dentro del laboratorio, NO en esta máquina. La API
# se conecta como clicksafe_api (mínimo privilegio, nunca root). Ese usuario
# se crea a mano en el laboratorio como 'clicksafe_api'@'192.168.20.10'
# (la IP exacta de esta PC -- ver database/clicksafe_db.sql).
DB_HOST=192.168.30.10
DB_PORT=3306
DB_USERNAME=clicksafe_api
DB_PASSWORD=GENERA-O-COPIA-LA-CONTRASEÑA-REAL-DE-clicksafe_api
DB_NAME=clicksafe_db
DB_POOL_SIZE=20

# Solo para npm run db:backup / npm run db:restore, corridos a mano desde
# esta PC; nunca los usa la API en sí. Ajusta la ruta si MySQL Server está
# instalado en otra carpeta.
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# Mailpit corre en esta misma PC (la de la API), por eso sigue en 127.0.0.1.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=ClickSafe <no-reply@clicksafe.local>

# Ruta absoluta y fuera de la carpeta del código (sección 6) -- a diferencia
# de .env.example (ruta relativa a api/), aquí se fija absoluta porque así
# la pidió el laboratorio. Crea la carpeta antes de arrancar la API. Barras
# normales (Windows las acepta igual que las invertidas): más seguras en un
# archivo de variables de entorno, donde \ puede leerse como un carácter de
# escape según la herramienta que lo procese.
STORAGE_DIR=C:/clicksafe/storage

# Descomenta y completa solo la primera vez que corras `npm run
# seed:admin:lab` en esta PC.
# SEED_ADMIN_NOMBRE=Admin ClickSafe
# SEED_ADMIN_CORREO=admin@tu-dominio.com

# Permiso explícito para `npm run seed:demo:lab` (reportes/usuarios de
# ejemplo para la demo, incluidos reportes pendientes para probar
# validar/rechazar). Sin esto, seed-demo.ts se niega a correr con
# NODE_ENV=production -- aquí sí se activa a propósito, porque este
# NODE_ENV=production es el del laboratorio, no el de un despliegue real.
ALLOW_DEMO_SEED=true
