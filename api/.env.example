# Copia este archivo a api/.env (NO se versiona).
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=3000

# Vacío = CORS deshabilitado (recomendado: la app iOS no lo necesita).
# Si se llena, solo esos orígenes exactos, separados por coma.
CORS_ORIGINS=

# true SOLO si la API corre detrás de un proxy real (p. ej. Nginx). Si se
# activa sin proxy, un atacante puede falsificar X-Forwarded-For y evadir
# el rate limiting.
TRUST_PROXY=false

# En producción debe quedar en false: expone la documentación de la API.
SWAGGER_ENABLED=false

# Firma los access tokens (HS256). Mínimo 32 caracteres. NO reutilizar este
# valor para JWT_MFA_SECRET ni ningún otro secreto.
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
JWT_ISSUER=clicksafe-api
JWT_AUDIENCE=clicksafe-app

# Firma los mfaToken de 2FA (5.4/5.5). Secreto propio, distinto de JWT_ACCESS_SECRET.
JWT_MFA_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

# Cifra el secreto TOTP (AES-256-GCM, 5.5). Debe decodificar a 32 bytes
# exactos en base64 — genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=cambia-este-valor-32-bytes-en-base64

# HMAC de los códigos de verificación/recuperación (5.3/5.7).
CODE_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

# HMAC del reto proof-of-work del captcha (5.2).
CAPTCHA_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

# Firma las URLs de evidencias (sección 6, punto 8).
EVIDENCE_URL_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

# Rate limit global (4.4): 100 peticiones/minuto por IP o usuario.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Rate limit de /auth/* (4.4): 5 peticiones/minuto por IP.
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5

# Rate limit de creación de reportes/comentarios/denuncias (4.4), por usuario.
THROTTLE_REPORTS_TTL_MS=3600000
THROTTLE_REPORTS_LIMIT=10
THROTTLE_COMMENTS_TTL_MS=3600000
THROTTLE_COMMENTS_LIMIT=30
THROTTLE_FLAGS_TTL_MS=3600000
THROTTLE_FLAGS_LIMIT=20

# Conexión a MySQL. La API se conecta como clicksafe_api (mínimo privilegio),
# NUNCA como root (sección 2). Corresponde a infra/docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=clicksafe_api
DB_PASSWORD=cambia-este-valor-por-la-contraseña-de-clicksafe_api
DB_NAME=clicksafe_db

# Correo vía Mailpit en desarrollo (sin servicios externos).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=ClickSafe <no-reply@clicksafe.local>

# Carpeta de evidencias, fuera de la carpeta del código (sección 6).
# Relativa a api/; por defecto resuelve a <repo>/storage.
STORAGE_DIR=../storage

# Solo los usa `npm run seed:admin` (sección 8). Opcionales: el resto de la
# API arranca sin ellos. Descomenta y completa antes de correr el script.
# SEED_ADMIN_NOMBRE=Admin ClickSafe
# SEED_ADMIN_CORREO=admin@tu-dominio.com
