# Copia este archivo a api/.env.test (NO se versiona). Lo usa SOLO
# `npm run test:e2e` (NODE_ENV=test, lo fija Jest automáticamente).
#
# DB_NAME tiene que ser EXACTAMENTE "clicksafe_test": si no coincide, la API
# se niega a arrancar (env.schema.ts) y las pruebas nunca llegan a tocar la
# base de desarrollo clicksafe_db (7). Instrucciones para crear esa base y
# su usuario en el README, sección "Base de datos para las pruebas e2e".
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No reutilices los mismos valores que api/.env: si uno se filtra, el otro
# entorno sigue protegido.

NODE_ENV=test
PORT=3000

CORS_ORIGINS=
TRUST_PROXY=false
SWAGGER_ENABLED=false

JWT_ACCESS_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
JWT_ISSUER=clicksafe-api
JWT_AUDIENCE=clicksafe-app
JWT_MFA_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

TOTP_ENCRYPTION_KEY=cambia-este-valor-32-bytes-en-base64
CODE_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
CAPTCHA_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
EVIDENCE_URL_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_REPORTS_TTL_MS=3600000
THROTTLE_REPORTS_LIMIT=10
THROTTLE_COMMENTS_TTL_MS=3600000
THROTTLE_COMMENTS_LIMIT=30
THROTTLE_FLAGS_TTL_MS=3600000
THROTTLE_FLAGS_LIMIT=20

# Usuario dedicado SOLO a esta base (sección "Base de datos para las
# pruebas e2e" del README) — nunca el mismo que usa clicksafe_api en
# desarrollo/producción, para que una fuga de esta contraseña no sirva de
# nada contra la base real.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=clicksafe_api_test
DB_PASSWORD=cambia-este-valor-por-la-contraseña-de-clicksafe_api_test
DB_NAME=clicksafe_test

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=ClickSafe Test <no-reply@clicksafe.local>

STORAGE_DIR=../storage-test
