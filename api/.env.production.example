# Copia este archivo a api/.env en la PC del backend (NO se versiona).
# Pensado para la topología del laboratorio (docs/despliegue.md):
#   - Esta PC (Linux): la API + Nginx como proxy inverso con TLS.
#   - Otra PC: MySQL, alcanzable SOLO desde la IP de esta PC.
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilices los secretos de api/.env.example (desarrollo) aquí.

NODE_ENV=production
PORT=3000

# Vacío = CORS deshabilitado (la app iOS no lo necesita; el sitio de admin,
# si existe, se sirve detrás del mismo Nginx/origen).
CORS_ORIGINS=

# true: la API corre detrás de Nginx en la MISMA máquina (docs/despliegue.md).
# Si no hay proxy real delante, esto permite falsificar X-Forwarded-For y
# evadir el rate limiting — nunca lo pongas en true sin Nginx enfrente.
TRUST_PROXY=true

# false SIEMPRE en producción: Swagger es un mapa gratis para un atacante.
SWAGGER_ENABLED=false

JWT_ACCESS_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
JWT_ISSUER=clicksafe-api
JWT_AUDIENCE=clicksafe-app
JWT_MFA_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

TOTP_ENCRYPTION_KEY=cambia-este-valor-32-bytes-en-base64
CODE_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
CAPTCHA_HMAC_KEY=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres
EVIDENCE_URL_SECRET=cambia-este-valor-por-uno-generado-de-al-menos-32-caracteres

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_REPORTS_TTL_MS=3600000
THROTTLE_REPORTS_LIMIT=10
THROTTLE_COMMENTS_TTL_MS=3600000
THROTTLE_COMMENTS_LIMIT=30
THROTTLE_FLAGS_TTL_MS=3600000
THROTTLE_FLAGS_LIMIT=20

# MySQL vive en OTRA PC del laboratorio. clicksafe_api debe estar creado
# ahí restringido a la IP de ESTA PC (docs/despliegue.md), nunca con host '%'.
DB_HOST=IP_DE_LA_PC_DE_BASE_DE_DATOS
DB_PORT=3306
DB_USERNAME=clicksafe_api
DB_PASSWORD=cambia-este-valor-por-la-contraseña-de-clicksafe_api
DB_NAME=clicksafe_db

# Servidor de correo del laboratorio (Mailpit u otro SMTP interno). Si corre
# en esta misma PC, deja 127.0.0.1; si es otro nodo, pon su IP.
MAIL_HOST=IP_DEL_SERVIDOR_DE_CORREO
MAIL_PORT=1025
MAIL_FROM=ClickSafe <no-reply@clicksafe.local>

# Ruta ABSOLUTA fuera del código (systemd corre con otro working directory
# que en desarrollo) y con permisos solo para el usuario de servicio
# (infra/systemd/clicksafe-api.service). Nunca dentro de /home ni del repo.
STORAGE_DIR=/var/lib/clicksafe/storage

# SEED_ADMIN_NOMBRE=Admin ClickSafe
# SEED_ADMIN_CORREO=admin@tu-dominio.com
