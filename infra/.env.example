# Copia este archivo a infra/.env (NO se versiona) antes de correr docker-compose.
# Genera un valor real con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"

MYSQL_ROOT_PASSWORD=cambia-este-valor

# No se fija MYSQL_DATABASE: database/clicksafe_db.sql crea la base él
# mismo (ver docker-compose.yml) para poder fallar a propósito si ya existe.
